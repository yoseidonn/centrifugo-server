################################################################################
# FastAPI Integration with Centrifugo
# 
# IMPORTANT: These variables are for FastAPI backend ONLY!
# Centrifugo server uses config.json directly, NOT these environment variables.
#
# Purpose: Tell FastAPI how to connect to and communicate with Centrifugo
################################################################################

# Centrifugo Connection URLs
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket

# Authentication Secrets
# These MUST match the values in Centrifugo's config.json
CENTRIFUGO_API_KEY=your-api-key
CENTRIFUGO_TOKEN_SECRET=your-secret-key-here

# Feature Flag
CENTRIFUGO_ENABLED=true

################################################################################
# Configuration Notes:
#
# 1. Centrifugo Server Configuration:
#    - Edit config.json for production
#    - Edit config-dev.json for development
#    - Centrifugo reads these files directly on startup
#
# 2. FastAPI Backend Configuration:
#    - Add these variables to backend/.env
#    - FastAPI uses these to:
#      * Generate JWT tokens for clients
#      * Publish messages via HTTP API
#      * Query presence information
#
# 3. Keep Values Synchronized:
#    - CENTRIFUGO_API_KEY must match config.json's "api_key"
#    - CENTRIFUGO_TOKEN_SECRET must match config.json's "token_hmac_secret_key"
#
# 4. Security:
#    - Never commit actual secrets to git
#    - Use different secrets for dev/prod
#    - Rotate secrets regularly in production
################################################################################

# Visual Flow Diagram:
# ┌─────────────────────────────────────────────────────────┐
# │                   Centrifugo Server                     │
# │                                                         │
# │  Reads: config.json                                     │
# │  Contains:                                              │
# │    - token_hmac_secret_key: "your-secret-key-here"     │
# │    - api_key: "your-api-key"                           │
# │    - port: 8000                                         │
# │    - Redis settings                                     │
# │                                                         │
# └─────────────────────────────────────────────────────────┘
#                           ↓
#                  Listens on port 8000
#                           ↓
# ┌─────────────────────────────────────────────────────────┐
# │                   FastAPI Backend                       │
# │                                                         │
# │  Reads: .env                                            │
# │  Contains:                                              │
# │    - CENTRIFUGO_API_URL=http://localhost:8000/api      │
# │    - CENTRIFUGO_API_KEY=your-api-key                   │
# │    - CENTRIFUGO_TOKEN_SECRET=your-secret-key-here      │
# │                                                         │
# │  Uses these to:                                         │
# │    1. Generate JWT tokens for clients                  │
# │    2. Call Centrifugo HTTP API                         │
# │    3. Publish messages to Centrifugo                   │
# └─────────────────────────────────────────────────────────┘
#                           ↓
#                   Makes HTTP calls to
#                           ↓
#              http://localhost:8000/api
#              (with Authorization: apikey your-api-key)

################################################################################
# Configuration Workflow Examples:
#
# Step 1: Set up Centrifugo
# ┌─────────────────────────────────────────────────────────┐
# │ # Edit config.json                                      │
# │ {                                                       │
# │   "token_hmac_secret_key": "my-super-secret-key-123",  │
# │   "api_key": "my-api-key-456"                          │
# │ }                                                       │
# │                                                         │
# │ # Start Centrifugo                                      │
# │ sudo systemctl start centrifugo                        │
# └─────────────────────────────────────────────────────────┘
#
# Step 2: Configure FastAPI
# ┌─────────────────────────────────────────────────────────┐
# │ # Edit backend/.env                                      │
# │ CENTRIFUGO_API_KEY=my-api-key-456                      │
# │ CENTRIFUGO_TOKEN_SECRET=my-super-secret-key-123        │
# └─────────────────────────────────────────────────────────┘
#
# Step 3: Verify Values Match
# ┌─────────────────────────────────────────────────────────┐
# │ # FastAPI uses these values to:                         │
# │                                                         │
# │ # 1. Generate client tokens                             │
# │ import jwt                                              │
# │ token = jwt.encode(                                     │
# │     {"sub": "user123"},                                 │
# │     "my-super-secret-key-123",  # From CENTRIFUGO_TOKEN_SECRET │
# │     algorithm="HS256"                                   │
# │ )                                                       │
# │                                                         │
# │ # 2. Call Centrifugo API                                │
# │ headers = {                                             │
# │     "Authorization": f"apikey my-api-key-456"  # From CENTRIFUGO_API_KEY │
# │ }                                                       │
# │ response = requests.post("http://localhost:8000/api", headers=headers, ...) │
# └─────────────────────────────────────────────────────────┘
################################################################################

# Key Points:
# 1. Two separate configuration files:
#    - centrifugo-server/config.json → For Centrifugo server
#    - backend/.env → For FastAPI backend
#
# 2. Same secrets, different locations:
#    - The API key and token secret must be identical in both files
#    - But they're stored in different formats (JSON vs ENV)
#
# 3. Purpose of each:
#    - Centrifugo uses config.json to configure itself
#    - FastAPI uses .env to know how to talk to Centrifugo
#
# 4. The env.example file:
#    - Is a template for developers
#    - Shows what to add to backend/.env
#    - Is NOT used by Centrifugo itself
