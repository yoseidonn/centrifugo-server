{
    "token_hmac_secret_key": "your-secret-key-here",
    "admin_password": "admin123",
    "api_key": "your-api-key",
    "http_server": {
      "port": "8000",
      "address": "0.0.0.0"
    },
    "allowed_origins": ["*"],
    "engine": "redis",
    "redis_address": "redis://localhost:6379",
    "redis_db": 1,
    "redis_prefix": "centrifugo",
    "namespaces": [
      {
        "name": "messages",
        "presence": true,
        "join_leave": true,
        "history_size": 100,
        "history_ttl": "300s"
      },
      {
        "name": "notifications",
        "presence": false,
        "join_leave": false,
        "history_size": 50,
        "history_ttl": "600s"
      },
      {
        "name": "dm",
        "presence": true,
        "join_leave": true,
        "history_size": 200,
        "history_ttl": "1800s"
      },
      {
        "name": "voice",
        "presence": true,
        "join_leave": true,
        "history_size": 10,
        "history_ttl": "60s"
      }
    ],
    "log_level": "info",
    "log_file": "/opt/centrifugo-server/logs/centrifugo.log",
    "log_handler": "file"
  }
  